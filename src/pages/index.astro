---
import '../styles/global.css';
import { HUDControlBar } from '../components/HUDControlBar';
import { TargetTracker } from '../components/TargetTracker';
import { TerminalBoot } from '../components/TerminalBoot';
import { GithubTelemetry } from '../components/GithubTelemetry';
import { PROFILE } from '../data/profile';
import {
  Shield,
  Cpu,
  Mail,
  MapPin,
  Calendar,
  Layers,
  Award,
  Zap,
  CheckCircle2,
  ExternalLink,
  GitBranch
} from 'lucide-react';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{PROFILE.name} | Terminator HUD Profile & Portfolio</title>
    <meta
      name="description"
      content={`${PROFILE.name} — Senior Full-Stack Engineer (28 yrs exp). Specialized in React Native/Expo, NestJS, WebRTC, SIP/Asterisk, and TypeScript.`}
    />
  </head>
  <body class="min-h-screen relative selection:bg-red-600 selection:text-white">
    <!-- CRT Scanlines and Vignette Layers -->
    <div id="crt-overlay-layer" class="crt-overlay fixed inset-0 pointer-events-none z-40"></div>
    <div class="crt-vignette fixed inset-0 pointer-events-none z-30"></div>

    <!-- Interactive Top HUD Control Bar -->
    <HUDControlBar client:load />

    <!-- Interactive Reticle Target Tracker -->
    <TargetTracker client:load />

    <!-- Main Container -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 relative z-10">
      <!-- Hero Section -->
      <section
        data-target-name={`UNIT: ${PROFILE.name.toUpperCase()}`}
        class="hud-box p-6 sm:p-8 rounded mb-10 overflow-hidden"
      >
        <div class="hud-corner hud-corner-tl"></div>
        <div class="hud-corner hud-corner-tr"></div>
        <div class="hud-corner hud-corner-bl"></div>
        <div class="hud-corner hud-corner-br"></div>

        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 border-b border-[var(--theme-border)] pb-6 mb-6">
          <div>
            <div class="flex items-center gap-2 text-[var(--theme-primary)] text-xs font-bold tracking-widest uppercase mb-2">
              <span class="w-2 h-2 rounded-full bg-[var(--theme-primary)] animate-ping"></span>
              TARGET ACQUIRED // MODEL: T-800 SYSTEM ARCHITECT
            </div>
            <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-[var(--theme-text-bright)] text-glow mb-2">
              {PROFILE.name}
            </h1>
            <p class="text-sm sm:text-base text-[var(--theme-primary)] font-semibold tracking-wide">
              {PROFILE.title}
            </p>
          </div>

          <!-- Quick Stats Matrix -->
          <div class="grid grid-cols-2 gap-3 text-xs font-mono">
            <div class="p-2.5 rounded bg-[var(--theme-primary-dim)] border border-[var(--theme-border)]">
              <div class="text-[10px] opacity-70">EXPERIENCE</div>
              <div class="text-lg font-black text-[var(--theme-text-bright)]">{PROFILE.yearsExperience}+ YEARS</div>
            </div>
            <div class="p-2.5 rounded bg-[var(--theme-primary-dim)] border border-[var(--theme-border)]">
              <div class="text-[10px] opacity-70">CODE COVERAGE</div>
              <div class="text-lg font-black text-[var(--theme-text-bright)]">TDD / 90%+</div>
            </div>
            <div class="p-2.5 rounded bg-[var(--theme-primary-dim)] border border-[var(--theme-border)]">
              <div class="text-[10px] opacity-70">LOCATION</div>
              <div class="text-xs font-bold text-[var(--theme-text-bright)]">Lviv · Remote</div>
            </div>
            <div class="p-2.5 rounded bg-[var(--theme-primary-dim)] border border-[var(--theme-border)]">
              <div class="text-[10px] opacity-70">AVAILABILITY</div>
              <div class="text-xs font-bold text-green-400">OPEN TO WORK</div>
            </div>
          </div>
        </div>

        <p class="text-sm leading-relaxed text-[var(--theme-text)] opacity-90 max-w-4xl mb-6">
          {PROFILE.summary}
        </p>

        <!-- Communication & Links -->
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a
            href={`mailto:${PROFILE.email}`}
            data-target-name="DIRECT COMM: EMAIL"
            class="flex items-center gap-2 px-4 py-2 rounded text-xs font-bold bg-[var(--theme-primary)] text-black hover:opacity-90 transition-opacity"
          >
            <Mail className="w-4 h-4" />
            <span>TRANSMIT EMAIL ({PROFILE.email})</span>
          </a>

          <a
            href={PROFILE.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            data-target-name="LINK: LINKEDIN PROFILE"
            class="flex items-center gap-2 px-4 py-2 rounded text-xs font-bold border border-[var(--theme-border)] text-[var(--theme-text)] hover:bg-[var(--theme-primary-dim)] transition-colors"
          >
            <svg class="w-4 h-4 text-[var(--theme-primary)] fill-current" viewBox="0 0 24 24">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.6 1.6 0 1 0 0-3.2 1.6 1.6 0 0 0 0 3.2m1.4 9.74v-8.37H5.06v8.37h2.8z"/>
            </svg>
            <span>LINKEDIN</span>
          </a>

          <a
            href={PROFILE.github}
            target="_blank"
            rel="noopener noreferrer"
            data-target-name="LINK: GITHUB PROFILE"
            class="flex items-center gap-2 px-4 py-2 rounded text-xs font-bold border border-[var(--theme-border)] text-[var(--theme-text)] hover:bg-[var(--theme-primary-dim)] transition-colors"
          >
            <svg class="w-4 h-4 text-[var(--theme-primary)] fill-current" viewBox="0 0 24 24">
              <path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z"/>
            </svg>
            <span>GITHUB</span>
          </a>
        </div>
      </section>

      <!-- System Diagnostics Terminal -->
      <TerminalBoot client:visible />

      <!-- Skill Matrix Section -->
      <section class="my-12">
        <div class="flex items-center gap-2 mb-6 border-b border-[var(--theme-border)] pb-2">
          <Cpu className="w-5 h-5 text-[var(--theme-primary)]" />
          <h2 class="text-sm font-bold tracking-widest text-[var(--theme-primary)] text-glow">
            NEURAL NETWORK CAPABILITY MODULES
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {PROFILE.skillCategories.map((cat) => (
            <div
              key={cat.code}
              data-target-name={`MODULE: ${cat.category.toUpperCase()}`}
              class="hud-box p-5 rounded"
            >
              <div class="hud-corner hud-corner-tl"></div>
              <div class="hud-corner hud-corner-tr"></div>
              <div class="hud-corner hud-corner-bl"></div>
              <div class="hud-corner hud-corner-br"></div>

              <div class="flex items-center justify-between mb-3 border-b border-[var(--theme-border)] pb-2">
                <span class="text-xs font-bold text-[var(--theme-text-bright)]">
                  {cat.category}
                </span>
                <span class="text-[10px] font-mono text-[var(--theme-primary)] font-bold">
                  {cat.code}
                </span>
              </div>

              <div class="flex flex-wrap gap-2">
                {cat.skills.map((skill) => (
                  <span
                    key={skill}
                    data-target-name={`SKILL: ${skill.toUpperCase()}`}
                    class="px-2.5 py-1 rounded text-xs bg-[var(--theme-primary-dim)] text-[var(--theme-text-bright)] border border-[var(--theme-border)] hover:border-[var(--theme-primary)] transition-colors"
                  >
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Featured Missions / Projects Showcase -->
      <section class="my-12">
        <div class="flex items-center gap-2 mb-6 border-b border-[var(--theme-border)] pb-2">
          <Shield className="w-5 h-5 text-[var(--theme-primary)]" />
          <h2 class="text-sm font-bold tracking-widest text-[var(--theme-primary)] text-glow">
            DEPLOYED MISSION PLATFORMS // ARCHITECTURAL SHOWCASE
          </h2>
        </div>

        <div class="space-y-6">
          {PROFILE.featuredProjects.map((p) => (
            <article
              key={p.id}
              data-target-name={p.codename}
              class="hud-box p-6 rounded"
            >
              <div class="hud-corner hud-corner-tl"></div>
              <div class="hud-corner hud-corner-tr"></div>
              <div class="hud-corner hud-corner-bl"></div>
              <div class="hud-corner hud-corner-br"></div>

              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
                <div class="flex items-center gap-2">
                  <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-[var(--theme-primary-dim)] text-[var(--theme-primary)] border border-[var(--theme-primary)] font-bold">
                    {p.codename}
                  </span>
                  <h3 class="text-base sm:text-lg font-bold text-[var(--theme-text-bright)]">
                    {p.title}
                  </h3>
                </div>
                <span class="text-xs font-mono text-[var(--theme-primary)] opacity-80">
                  {p.period}
                </span>
              </div>

              <p class="text-xs text-[var(--theme-text)] opacity-80 mb-3 italic">
                {p.subtitle}
              </p>

              <p class="text-xs sm:text-sm text-[var(--theme-text)] opacity-90 leading-relaxed mb-4">
                {p.description}
              </p>

              <!-- Metrics / Proof Points -->
              <div class="mb-4 bg-[var(--theme-surface-hover)] p-3 rounded border border-[var(--theme-border)]">
                <div class="text-[10px] font-bold text-[var(--theme-primary)] uppercase tracking-wider mb-2">
                  Verified Performance Metrics:
                </div>
                <ul class="grid grid-cols-1 md:grid-cols-2 gap-2 text-xs">
                  {p.metrics.map((m) => (
                    <li key={m} class="flex items-start gap-1.5">
                      <CheckCircle2 className="w-3.5 h-3.5 text-green-400 mt-0.5 shrink-0" />
                      <span>{m}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Tech Badges -->
              <div class="flex flex-wrap gap-1.5">
                {p.tech.map((t) => (
                  <span
                    key={t}
                    class="px-2 py-0.5 rounded text-[11px] font-mono bg-[var(--theme-primary-dim)] text-[var(--theme-primary)] border border-[var(--theme-border)]"
                  >
                    {t}
                  </span>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Live GitHub Telemetry -->
      <GithubTelemetry client:visible />

      <!-- Education & Credentials -->
      <section class="my-12">
        <div class="flex items-center gap-2 mb-6 border-b border-[var(--theme-border)] pb-2">
          <Award className="w-5 h-5 text-[var(--theme-primary)]" />
          <h2 class="text-sm font-bold tracking-widest text-[var(--theme-primary)] text-glow">
            ACADEMIC CREDENTIALS & SYSTEM LANGUAGES
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div data-target-name="EDUCATION RECORD" class="hud-box p-5 rounded">
            <div class="hud-corner hud-corner-tl"></div>
            <div class="hud-corner hud-corner-tr"></div>
            <div class="hud-corner hud-corner-bl"></div>
            <div class="hud-corner hud-corner-br"></div>

            <h3 class="text-xs font-bold text-[var(--theme-primary)] mb-2">ACADEMIC FOUNDATION</h3>
            <p class="text-sm font-bold text-[var(--theme-text-bright)] mb-1">
              {PROFILE.education.degree}
            </p>
            <p class="text-xs text-[var(--theme-text)] opacity-80 mb-2">
              {PROFILE.education.institution}
            </p>
            <span class="text-xs font-mono text-[var(--theme-primary)]">
              {PROFILE.education.years}
            </span>
          </div>

          <div data-target-name="LINGUISTIC CAPABILITY" class="hud-box p-5 rounded">
            <div class="hud-corner hud-corner-tl"></div>
            <div class="hud-corner hud-corner-tr"></div>
            <div class="hud-corner hud-corner-bl"></div>
            <div class="hud-corner hud-corner-br"></div>

            <h3 class="text-xs font-bold text-[var(--theme-primary)] mb-2">LINGUISTIC SUBSYSTEMS</h3>
            <div class="space-y-2 text-xs">
              {PROFILE.languages.map((l) => (
                <div key={l.name} class="flex items-center justify-between border-b border-[var(--theme-border)] pb-1">
                  <span class="font-bold text-[var(--theme-text-bright)]">{l.name}</span>
                  <span class="font-mono text-[var(--theme-primary)]">{l.level}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- Footer -->
      <footer class="mt-16 pt-8 border-t border-[var(--theme-border)] text-center text-xs text-[var(--theme-text)] opacity-70 pb-12">
        <div class="flex items-center justify-center gap-2 mb-2 font-mono text-[var(--theme-primary)]">
          <span class="inline-block w-2 h-2 rounded-full bg-[var(--theme-primary)] animate-pulse"></span>
          CYBERDYNE SYSTEMS // DEFENSE NETWORK // MODEL T-800
        </div>
        <p>Built with Astro 5, React, and Tailwind CSS. Strictly compliant with client NDA policies.</p>
        <p class="mt-1 text-[11px] opacity-60">© 2026 {PROFILE.name}. All systems operational.</p>
      </footer>
    </main>
  </body>
</html>
